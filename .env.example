# Required PostgreSQL / Neon connection string. The server refuses to start without it.
DATABASE_URL=

# SESSION_SECRET: Secret for signing session cookies/tokens (auto-generates ephemeral secret if unset)
SESSION_SECRET=

# GEMINI_API_KEY: Optional Gemini API key injected at runtime
GEMINI_API_KEY=

# APP_URL: Application base URL
APP_URL=http://localhost:3000

# First administrator: used only by npm run setup:admin on an empty database.
# Set privately, then remove INITIAL_ADMIN_PASSWORD after setup.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
